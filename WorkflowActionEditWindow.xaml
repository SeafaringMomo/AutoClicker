<Window x:Class="AutoClicker.WorkflowActionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoClicker.Models"
        xmlns:vm="clr-namespace:AutoClicker.ViewModels"
        xmlns:conv="clr-namespace:AutoClicker.Converters"
        Title="编辑流程动作" Height="540" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F8F9FA">

    <Window.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="TestBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#F39C12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 动作类型 -->
            <RowDefinition Height="*"/>      <!-- 字段区 -->
            <RowDefinition Height="Auto"/>   <!-- 测试结果 -->
            <RowDefinition Height="Auto"/>   <!-- 按钮 -->
        </Grid.RowDefinitions>

        <!-- 动作类型选择 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,12" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="动作类型:" Margin="0,0,8,0" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding Source={x:Static vm:WorkflowActionEditViewModel.AvailableActionTypes}}"
                          SelectedItem="{Binding Type, Mode=TwoWay}"
                          Width="200"/>
            </StackPanel>
        </Border>

        <!-- 字段区 (按动作类型动态切换) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Padding="14" CornerRadius="4">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 公共字段: 描述 -->
                    <TextBlock Text="动作描述 (可选):" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <!-- 公共字段: 延迟 -->
                    <TextBlock Text="执行前延迟 (毫秒):" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Width="120" HorizontalAlignment="Left"/>

                    <!-- ========== 鼠标动作字段 ========== -->
                    <StackPanel Visibility="{Binding IsMouseAction, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#E3F2FD" BorderBrush="#BBDEFB" BorderThickness="1" Padding="8" Margin="0,0,0,8" CornerRadius="3">
                            <TextBlock Text="🖱 鼠标动作参数" FontWeight="Bold" Foreground="#1976D2"/>
                        </Border>

                        <TextBlock Text="鼠标按钮:" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Content="左键" GroupName="MouseBtn"
                                         IsChecked="{Binding Button, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:MouseButton.Left}}"
                                         Margin="0,0,12,0" Cursor="Hand"/>
                            <RadioButton Content="右键" GroupName="MouseBtn"
                                         IsChecked="{Binding Button, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:MouseButton.Right}}"
                                         Margin="0,0,12,0" Cursor="Hand"/>
                            <RadioButton Content="中键" GroupName="MouseBtn"
                                         IsChecked="{Binding Button, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:MouseButton.Middle}}"
                                         Cursor="Hand"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="X 坐标:" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Y 坐标:" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ========== 键盘文本字段 ========== -->
                    <StackPanel Visibility="{Binding IsKeyboardTextAction, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1" Padding="8" Margin="0,0,0,8" CornerRadius="3">
                            <TextBlock Text="⌨ 键盘文本输入" FontWeight="Bold" Foreground="#388E3C"/>
                        </Border>

                        <TextBlock Text="输入内容:" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="60" Margin="0,0,0,0"/>
                    </StackPanel>

                    <!-- ========== 单键按下字段 ========== -->
                    <StackPanel Visibility="{Binding IsKeyPressAction, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" Padding="8" Margin="0,0,0,8" CornerRadius="3">
                            <TextBlock Text="⌨ 单键按下" FontWeight="Bold" Foreground="#F57C00"/>
                        </Border>

                        <TextBlock Text="虚拟键码 (16进制, 如 0x0D=Enter, 0x1B=Esc):" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding VirtualKey, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- ========== Wait 字段 ========== -->
                    <StackPanel Visibility="{Binding IsWaitAction, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="1" Padding="8" Margin="0,0,0,8" CornerRadius="3">
                            <TextBlock Text="⏱ 显式等待" FontWeight="Bold" Foreground="#546E7A"/>
                        </Border>

                        <TextBlock Text="等待时长 (毫秒, 在上方延迟字段设置):" Margin="0,0,0,4" Foreground="#666"/>
                    </StackPanel>

                    <!-- ========== WaitForWindow 字段 ========== -->
                    <StackPanel Visibility="{Binding IsWaitForWindowAction, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#F3E5F5" BorderBrush="#E1BEE7" BorderThickness="1" Padding="8" Margin="0,0,0,8" CornerRadius="3">
                            <TextBlock Text="⏳ 等待窗口出现" FontWeight="Bold" Foreground="#7B1FA2"/>
                        </Border>

                        <TextBlock Text="窗口标题模式 (支持 * 通配符):" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding WindowTitlePattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="窗口类名 (可选):" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding WindowClassName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="进程名 (可选):" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="超时毫秒:" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                        <CheckBox Content="找到后激活窗口置顶" IsChecked="{Binding ActivateWindow}" Margin="0,0,0,8" Cursor="Hand"/>

                        <TextBlock Text="失败处理:" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Source={x:Static vm:WorkflowActionEditViewModel.AvailableFailureActions}}"
                                  SelectedItem="{Binding OnFailure, Mode=TwoWay}"
                                  Width="200" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="🎯 拾取当前窗口" Style="{StaticResource TestBtn}"
                                    Command="{Binding PickCurrentWindowCommand}" Margin="0,0,8,0"/>
                            <Button Content="🔍 测试匹配" Style="{StaticResource TestBtn}"
                                    Command="{Binding TestMatchCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========== ExtractText 字段 ========== -->
                    <StackPanel Visibility="{Binding IsExtractTextAction, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#FFFDE7" BorderBrush="#FFF9C4" BorderThickness="1" Padding="8" Margin="0,0,0,8" CornerRadius="3">
                            <TextBlock Text="📋 提取文本到变量" FontWeight="Bold" Foreground="#F9A825"/>
                        </Border>

                        <TextBlock Text="文本来源:" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Source={x:Static vm:WorkflowActionEditViewModel.AvailableTextSources}}"
                                  SelectedItem="{Binding TextSource, Mode=TwoWay}"
                                  Width="220" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                        <!-- 子控件类名 (ChildControlText 时显示) -->
                        <StackPanel Visibility="{Binding IsChildControlTextSource, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="子控件类名:" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TargetControlClass, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Width="200" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- 控件序号 (ChildControlText/EditControlValue 时显示) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChildControlTextSource}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditControlSource}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="控件序号 (0=第一个):" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TargetControlIndex, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        </StackPanel>

                        <TextBlock Text="保存到变量名:" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding OutputVariable, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Width="200" HorizontalAlignment="Left"/>

                        <TextBlock Text="提示: 变量仅用于日志/状态栏显示，不参与后续动作决策 (固定坐标回放)"
                                   FontSize="10" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <Button Content="🔍 测试提取" Style="{StaticResource TestBtn}"
                                Command="{Binding TestExtractCommand}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 测试结果反馈 -->
        <Border Grid.Row="2" Background="#FFFBE6" BorderBrush="#FFE58F" BorderThickness="1" Padding="8,4" Margin="0,8,0,8" CornerRadius="3"
                Visibility="{Binding TestResult, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
            <TextBlock Text="{Binding TestResult}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/>
        </Border>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource PrimaryBtn}"
                    Command="{Binding CancelCommand}" Margin="0,0,8,0"
                    Background="#95A5A6"/>
            <Button Content="确定" Style="{StaticResource SuccessBtn}"
                    Command="{Binding OkCommand}"/>
        </StackPanel>
    </Grid>
</Window>
