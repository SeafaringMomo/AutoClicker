<Window x:Class="AutoClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoClicker.Models"
        xmlns:vm="clr-namespace:AutoClicker.ViewModels"
        xmlns:conv="clr-namespace:AutoClicker.Converters"
        mc:Ignorable="d"
        Title="AutoClicker v1.5.0" Height="720" Width="640"
        MinWidth="600" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        DataContext="{Binding RelativeSource={RelativeSource Self}, Path=ViewModel}">

    <Window.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        <conv:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
        <conv:BoolToBrushConverter x:Key="BoolToBrushConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:StringToBrushConverter x:Key="StringToBrushConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <!-- ========== 一级 Tab (单点连点 / 流程点击) ========== -->
        <Style x:Key="PrimaryTabRadioButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="BorderBrush" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="#3498DB"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 二级 SegmentedControl (悬停定位/窗口树定位, 新建/使用) ========== -->
        <Style x:Key="SegmentedRadioButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F8FF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#2980B9"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== TreeView 展开按钮 ========== -->
        <Style x:Key="ExpanderToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="Arrow" Fill="#666" Data="M 0 0 L 4 4 L 8 0 Z" VerticalAlignment="Center" HorizontalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="90" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="HeaderBorder" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Margin="0,0,4,0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Style="{StaticResource ExpanderToggleButtonStyle}"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:WindowTreeNodeWrapper}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource TreeViewItemStyle}">
            <TextBlock Text="{Binding Node.DisplayText}" ToolTip="{Binding Node.DisplayText}" FontSize="12" FontFamily="Consolas"/>
        </HierarchicalDataTemplate>

        <!-- ========== 流程动作 ListBox 项模板 ========== -->
        <DataTemplate x:Key="WorkflowActionItemTemplate" DataType="{x:Type vm:WorkflowActionViewModel}">
            <Border Background="{Binding BackgroundHex, Converter={StaticResource StringToBrushConverter}}"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TypeIcon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding DelayText}" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0" FontFamily="Consolas"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 顶部 Tab 栏 -->
            <RowDefinition Height="*"/>      <!-- 主内容区 -->
            <RowDefinition Height="Auto"/>   <!-- 单点连点底部参数 -->
            <RowDefinition Height="Auto"/>   <!-- 启停按钮 -->
            <RowDefinition Height="Auto"/>   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ========== Row 0: 顶部 Tab 栏 ========== -->
        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,4" Margin="-10,-10,-10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource PrimaryTabRadioButton}"
                                 GroupName="PrimaryMode"
                                 IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:ClickMode.SingleClick}}"
                                 Command="{Binding ToggleModeCommand}"
                                 CommandParameter="{x:Static local:ClickMode.SingleClick}"
                                 ToolTip="单点连点模式 (合并原模式1+模式2: F6启停, F7捕获坐标, F8拾取窗口)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4CD;" Margin="0,0,6,0" FontSize="14"/>
                            <TextBlock Text="单点连点"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource PrimaryTabRadioButton}"
                                 GroupName="PrimaryMode"
                                 IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:ClickMode.Workflow}}"
                                 Command="{Binding ToggleModeCommand}"
                                 CommandParameter="{x:Static local:ClickMode.Workflow}"
                                 ToolTip="流程点击模式 (录制键鼠操作序列: F9录制启停, F10暂停, Ctrl+Esc强制停止)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F3AC;" Margin="0,0,6,0" FontSize="14"/>
                            <TextBlock Text="流程点击"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Menu Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Background="Transparent">
                    <MenuItem Header="&#x2699;&#xFE0F; 设置" FontSize="13" Padding="10,6">
                        <MenuItem Header="&#x1F511; 自定义热键" Command="{Binding SettingsVM.OpenHotkeyConfigCommand}"/>
                        <Separator/>
                        <MenuItem Header="&#x1F4C2; 打开日志文件夹" Command="{Binding SettingsVM.ViewLogCommand}"/>
                        <MenuItem Header="&#x1F4E4; 导出配置" Command="{Binding SettingsVM.ExportConfigCommand}"/>
                        <MenuItem Header="&#x1F4E5; 导入配置" Command="{Binding SettingsVM.ImportConfigCommand}"/>
                        <Separator/>
                        <MenuItem Header="&#x1F504; 重置所有设置" Command="{Binding SettingsVM.ResetSettingsCommand}"/>
                    </MenuItem>
                </Menu>

                <Menu Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0" Background="Transparent">
                    <MenuItem Header="&#x2753; 帮助" FontSize="13" Padding="10,6">
                        <MenuItem Header="&#x1F4D6; 操作教程" Command="{Binding SettingsVM.OpenTutorialCommand}"/>
                        <MenuItem Header="&#x2139;&#xFE0F; 关于软件" Command="{Binding SettingsVM.ShowAboutCommand}"/>
                        <MenuItem Header="&#x1F517; GitHub" Command="{Binding SettingsVM.OpenGitHubCommand}"/>
                    </MenuItem>
                </Menu>
            </Grid>
        </Border>

        <!-- ========== Row 1: 主内容区 ========== -->
        <Grid Grid.Row="1" Margin="0,8,0,0">

            <!-- ========== 单点连点页 ========== -->
            <Grid Visibility="{Binding CurrentMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static local:ClickMode.SingleClick}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- SegmentedControl -->
                    <RowDefinition Height="*"/>      <!-- 子模式内容 -->
                </Grid.RowDefinitions>

                <!-- 子模式切换: SegmentedControl -->
                <Border Grid.Row="0" Background="#F5F5F5" Padding="4" CornerRadius="4" Margin="0,0,0,8" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentedRadioButton}"
                                     GroupName="SingleClickPositioning"
                                     IsChecked="{Binding CurrentPositioning, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:SingleClickPositioning.HoverPosition}}"
                                     Command="{Binding TogglePositioningCommand}"
                                     CommandParameter="{x:Static local:SingleClickPositioning.HoverPosition}"
                                     ToolTip="鼠标悬停在目标位置，启动后在该位置连点 (F7捕获坐标)">
                            <TextBlock Text="&#x1F4CD; 悬停定位"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentedRadioButton}"
                                     GroupName="SingleClickPositioning"
                                     IsChecked="{Binding CurrentPositioning, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:SingleClickPositioning.WindowTree}}"
                                     Command="{Binding TogglePositioningCommand}"
                                     CommandParameter="{x:Static local:SingleClickPositioning.WindowTree}"
                                     Margin="-1,0,0,0"
                                     ToolTip="通过窗口句柄树定位目标控件 (F8拾取窗口)">
                            <TextBlock Text="&#x1F333; 窗口树定位"/>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- 子模式内容 -->
                <Grid Grid.Row="1">
                    <!-- 悬停定位面板 -->
                    <Border x:Name="HoverPanel"
                            Visibility="{Binding CurrentPositioning, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static local:SingleClickPositioning.HoverPosition}}"
                            Background="#FAFAFA" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="4" Padding="14">
                        <StackPanel>
                            <TextBlock Text="&#x1F4CD; 悬停定位模式" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,12"/>

                            <TextBlock Text="目标位置:" FontSize="13" FontWeight="Medium" Margin="0,0,0,4"/>
                            <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" Padding="8" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtPositionInfo" Text="{Binding HoverVM.PositionText}" FontSize="13" Foreground="#34495E" FontFamily="Consolas"/>
                            </Border>

                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="&#x1F3AF; 捕获当前位置 (F7)"
                                        Command="{Binding HoverVM.CapturePositionCommand}"
                                        Padding="14,6" Margin="0,0,8,8"
                                        Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="&#x1F5D1; 清除位置"
                                        Command="{Binding HoverVM.ClearPositionCommand}"
                                        Padding="14,6" Margin="0,0,8,8"
                                        Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="&#x1F4CB; 复制坐标"
                                        Command="{Binding HoverVM.CopyPositionCommand}"
                                        Padding="14,6" Margin="0,0,8,8"
                                        Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="&#x1F4E5; 粘贴坐标"
                                        Command="{Binding HoverVM.PastePositionCommand}"
                                        Padding="14,6" Margin="0,0,8,8"
                                        Background="#F39C12" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            </WrapPanel>

                            <CheckBox Content="捕获后自动开始连点"
                                      IsChecked="{Binding HoverVM.AutoStartAfterCapture}"
                                      FontSize="13" Margin="0,8,0,0" VerticalContentAlignment="Center"/>

                            <Border Background="#FFFBE6" BorderBrush="#FFE58F" BorderThickness="1" Padding="10" Margin="0,16,0,0" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="&#x1F4A1; 使用提示" FontSize="12" FontWeight="Bold" Foreground="#D48806" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="11" Foreground="#595959" TextWrapping="Wrap">
                                        <Run Text="1. 将鼠标移动到目标位置，按 F7 捕获坐标"/>
                                        <LineBreak/>
                                        <Run Text="2. 在底部选择鼠标按钮与间隔"/>
                                        <LineBreak/>
                                        <Run Text="3. 按 F6 或点击「开始连点」启动"/>
                                        <LineBreak/>
                                        <Run Text="4. 任何模式下 Ctrl+Esc 强制停止"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 窗口树定位面板 -->
                    <Grid x:Name="WindowTreePanel"
                          Visibility="{Binding CurrentPositioning, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static local:SingleClickPositioning.WindowTree}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 工具栏 -->
                        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6">
                            <WrapPanel>
                                <Button Content="&#x1F504; 刷新窗口列表"
                                        Command="{Binding WindowTreeVM.RefreshCommand}"
                                        Padding="10,4" Margin="0,0,8,4"
                                        Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="&#x1F3AF; 十字拾取窗口 (F8)"
                                        Command="{Binding WindowTreeVM.PickWindowCommand}"
                                        Padding="10,4" Margin="0,0,8,4"
                                        Background="#9B59B6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="&#x2795; 展开全部"
                                        Command="{Binding WindowTreeVM.ExpandAllCommand}"
                                        Padding="10,4" Margin="0,0,8,4"
                                        Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="&#x2796; 折叠全部"
                                        Command="{Binding WindowTreeVM.CollapseAllCommand}"
                                        Padding="10,4" Margin="0,0,8,4"
                                        Background="#F39C12" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            </WrapPanel>
                        </Border>

                        <!-- 筛选 -->
                        <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#E8E8E8" BorderThickness="0,1" Padding="8,6" VerticalAlignment="Top">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#x1F50D; 筛选:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                                <TextBox Grid.Column="1" Text="{Binding WindowTreeVM.FilterText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                         VerticalAlignment="Center" Padding="6,4" FontSize="13"
                                         ToolTip="按类名/标题/句柄筛选"/>
                                <Button Grid.Column="2" Content="&#x2715; 清除"
                                        Command="{Binding WindowTreeVM.ClearSelectionCommand}"
                                        Padding="10,4" Margin="8,0,0,0"
                                        Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Margin="0,8,0,0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                            <TreeView x:Name="WindowTreeView"
                                      ItemsSource="{Binding WindowTreeVM.TreeItems}"
                                      SelectedItemChanged="OnWindowTreeSelected"
                                      Background="White"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeViewItemStyle}"/>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </Border>

                        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      Background="Transparent"
                                      ShowsPreview="True"
                                      DragDelta="OnGridSplitterDragDelta"
                                      Cursor="SizeNS">
                            <GridSplitter.Template>
                                <ControlTemplate TargetType="GridSplitter">
                                    <Border Background="#E8E8E8" Height="5" Cursor="SizeNS">
                                        <Rectangle Width="30" Height="2" Fill="#BBB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </GridSplitter.Template>
                        </GridSplitter>

                        <!-- 目标参数 -->
                        <Border Grid.Row="4" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12,10" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="&#x1F3AF; 目标窗口参数" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding WindowTreeVM.SelectedWindowText}" FontSize="12" Foreground="#555" FontFamily="Consolas" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="X 偏移:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding WindowTreeVM.OffsetX, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Y 偏移:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding WindowTreeVM.OffsetY, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" VerticalAlignment="Center"/>
                                </Grid>

                                <CheckBox Content="使用 PostMessage (异步, 抢票推荐)"
                                          IsChecked="{Binding WindowTreeVM.UsePostMessage}"
                                          FontSize="13" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ========== 流程点击页 ========== -->
            <Grid Visibility="{Binding CurrentMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static local:ClickMode.Workflow}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 二级 Tab -->
                    <RowDefinition Height="*"/>      <!-- 子页内容 -->
                </Grid.RowDefinitions>

                <!-- 二级 Tab: 新建流程 / 使用流程 -->
                <Border Grid.Row="0" Background="#F5F5F5" Padding="4" CornerRadius="4" Margin="0,0,0,8" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentedRadioButton}"
                                     GroupName="WorkflowSubPage"
                                     IsChecked="{Binding WorkflowVM.CurrentSubPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:WorkflowModeViewModel+SubPage.Recorder}}"
                                     Command="{Binding WorkflowVM.SwitchToRecorderCommand}"
                                     ToolTip="录制新的键鼠操作序列 (F9启停, F10暂停)">
                            <TextBlock Text="&#x1F4DD; 新建流程"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentedRadioButton}"
                                     GroupName="WorkflowSubPage"
                                     IsChecked="{Binding WorkflowVM.CurrentSubPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:WorkflowModeViewModel+SubPage.Library}}"
                                     Command="{Binding WorkflowVM.SwitchToLibraryCommand}"
                                     Margin="-1,0,0,0"
                                     ToolTip="选择已保存的流程进行播放 (F6启停)">
                            <TextBlock Text="&#x25B6; 使用流程"/>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- 子页内容 -->
                <Grid Grid.Row="1">
                    <!-- ========== 流程录制子页 ========== -->
                    <Grid Visibility="{Binding WorkflowVM.CurrentSubPage, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static vm:WorkflowModeViewModel+SubPage.Recorder}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 录制控制 -->
                            <RowDefinition Height="Auto"/>   <!-- 元数据 -->
                            <RowDefinition Height="*"/>      <!-- 动作列表 -->
                            <RowDefinition Height="Auto"/>   <!-- 选中动作操作 -->
                        </Grid.RowDefinitions>

                        <!-- 录制控制 -->
                        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="&#x26AA; 开始录制 (F9)"
                                        Command="{Binding WorkflowVM.RecorderVM.StartRecordCommand}"
                                        Padding="12,8" Margin="0,0,8,0"
                                        FontSize="13" FontWeight="Bold"
                                        Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Visibility="{Binding WorkflowVM.RecorderVM.IsIdle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Grid.Column="0" Content="&#x23F8; 暂停 (F10)"
                                        Command="{Binding WorkflowVM.RecorderVM.PauseRecordCommand}"
                                        Padding="12,8" Margin="0,0,8,0"
                                        FontSize="13" FontWeight="Bold"
                                        Background="#F39C12" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Visibility="{Binding WorkflowVM.RecorderVM.IsRecording, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Grid.Column="0" Content="&#x25B6; 继续 (F10)"
                                        Command="{Binding WorkflowVM.RecorderVM.PauseRecordCommand}"
                                        Padding="12,8" Margin="0,0,8,0"
                                        FontSize="13" FontWeight="Bold"
                                        Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Visibility="{Binding WorkflowVM.RecorderVM.IsPaused, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <Button Grid.Column="1" Content="&#x23F9; 停止 (F9)"
                                        Command="{Binding WorkflowVM.RecorderVM.StopRecordCommand}"
                                        Padding="12,8" Margin="0,0,8,0"
                                        FontSize="13" FontWeight="Bold"
                                        Background="#7F8C8D" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        IsEnabled="{Binding WorkflowVM.RecorderVM.IsRecordingOrPaused}"/>

                                <Button Grid.Column="2" Content="&#x1F5D1; 清空"
                                        Command="{Binding WorkflowVM.RecorderVM.ClearActionsCommand}"
                                        Padding="12,8" Margin="0,0,8,0"
                                        FontSize="13"
                                        Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                                <Border Grid.Column="3" Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" Padding="8,4" CornerRadius="3" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="时长 " FontSize="12" Foreground="#666" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding WorkflowVM.RecorderVM.ElapsedText}" FontSize="13" FontWeight="Bold" Foreground="#E67E22" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        <TextBlock Text="  |  " FontSize="12" Foreground="#999" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding WorkflowVM.RecorderVM.ActionCountText}" FontSize="13" FontWeight="Bold" Foreground="#27AE60" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Button Grid.Column="4" Content="&#x1F4BE; 保存流程"
                                        Command="{Binding WorkflowVM.RecorderVM.SaveWorkflowCommand}"
                                        Padding="12,8" Margin="0,0,4,0"
                                        FontSize="13" FontWeight="Bold"
                                        Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                <CheckBox Grid.Column="5" Content="录制鼠标移动"
                                          IsChecked="{Binding WorkflowVM.RecorderVM.RecordMouseMove}"
                                          FontSize="11" VerticalContentAlignment="Center" Margin="8,0,0,0"
                                          ToolTip="勾选后录制鼠标移动事件 (默认不录制)"/>
                            </Grid>
                        </Border>

                        <!-- 元数据 -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="流程名称:" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding WorkflowVM.RecorderVM.WorkflowName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="流程描述 (可选):" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding WorkflowVM.RecorderVM.WorkflowDescription, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <!-- 动作列表 -->
                        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,6">
                                    <TextBlock Text="&#x1F4CB; 录制步骤 (可上移/下移/编辑)" FontSize="12" FontWeight="Bold" Foreground="#555"/>
                                </Border>
                                <ListBox Grid.Row="1"
                                         x:Name="ActionListBox"
                                         ItemsSource="{Binding WorkflowVM.RecorderVM.Actions}"
                                         ItemTemplate="{StaticResource WorkflowActionItemTemplate}"
                                         SelectedItem="{Binding WorkflowVM.RecorderVM.SelectedAction, Mode=TwoWay}"
                                         Background="White"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </Grid>
                        </Border>

                        <!-- 选中动作操作 -->
                        <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="10,8" Margin="0,8,0,0">
                            <WrapPanel>
                                <Button Content="&#x2B06; 上移"
                                        Command="{Binding WorkflowVM.RecorderVM.MoveUpCommand}"
                                        CommandParameter="{Binding WorkflowVM.RecorderVM.SelectedAction}"
                                        Padding="10,5" Margin="0,0,6,4"
                                        Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                                <Button Content="&#x2B07; 下移"
                                        Command="{Binding WorkflowVM.RecorderVM.MoveDownCommand}"
                                        CommandParameter="{Binding WorkflowVM.RecorderVM.SelectedAction}"
                                        Padding="10,5" Margin="0,0,6,4"
                                        Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                                <Button Content="&#x270F; 编辑"
                                        Command="{Binding WorkflowVM.RecorderVM.EditActionCommand}"
                                        CommandParameter="{Binding WorkflowVM.RecorderVM.SelectedAction}"
                                        Padding="10,5" Margin="0,0,6,4"
                                        Background="#F39C12" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                                <Button Content="&#x1F5D1; 删除"
                                        Command="{Binding WorkflowVM.RecorderVM.DeleteActionCommand}"
                                        CommandParameter="{Binding WorkflowVM.RecorderVM.SelectedAction}"
                                        Padding="10,5" Margin="0,0,6,4"
                                        Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>

                                <!-- v1.5.0: 智能动作插入分隔 -->
                                <Border Width="1" Background="#D0D0D0" Margin="6,2" />

                                <Button Content="&#x23F3; 等待窗口"
                                        Command="{Binding WorkflowVM.RecorderVM.InsertWaitForWindowCommand}"
                                        Padding="10,5" Margin="0,0,6,4"
                                        Background="#9B59B6" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"
                                        ToolTip="插入 WaitForWindow 智能动作: 等待指定窗口出现再继续 (需启用智能监测)"/>
                                <Button Content="&#x1F4CB; 提取信息"
                                        Command="{Binding WorkflowVM.RecorderVM.InsertExtractTextCommand}"
                                        Padding="10,5" Margin="0,0,6,4"
                                        Background="#F39C12" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"
                                        ToolTip="插入 ExtractText 智能动作: 从窗口提取文本到变量 (供后续步骤模板引用)"/>
                                <Button Content="&#x23F1; 插入等待"
                                        Command="{Binding WorkflowVM.RecorderVM.InsertWaitCommand}"
                                        Padding="10,5" Margin="0,0,6,4"
                                        Background="#7F8C8D" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"
                                        ToolTip="插入固定延时动作"/>

                                <TextBlock Text="提示: 录制期间会弹出半透明悬浮窗显示状态，可拖动到任意位置。"
                                           FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </WrapPanel>
                        </Border>
                    </Grid>

                    <!-- ========== 流程库子页 ========== -->
                    <Grid Visibility="{Binding WorkflowVM.CurrentSubPage, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static vm:WorkflowModeViewModel+SubPage.Library}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 工具栏 -->
                            <RowDefinition Height="*"/>      <!-- 列表 + 详情 -->
                            <RowDefinition Height="Auto"/>   <!-- 播放参数 -->
                            <RowDefinition Height="Auto"/>   <!-- 播放控制 -->
                        </Grid.RowDefinitions>

                        <!-- 工具栏 -->
                        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6" Margin="0,0,0,8">
                            <WrapPanel>
                                <Button Content="&#x1F504; 刷新列表"
                                        Command="{Binding WorkflowVM.LibraryVM.RefreshCommand}"
                                        Padding="10,4" Margin="0,0,8,4"
                                        Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                                <Button Content="&#x1F4E5; 导入流程"
                                        Command="{Binding WorkflowVM.LibraryVM.ImportCommand}"
                                        Padding="10,4" Margin="0,0,8,4"
                                        Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                                <Button Content="&#x1F4E4; 导出选中"
                                        Command="{Binding WorkflowVM.LibraryVM.ExportCommand}"
                                        Padding="10,4" Margin="0,0,8,4"
                                        Background="#F39C12" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                                <Button Content="&#x270F; 编辑流程"
                                        Command="{Binding WorkflowVM.LibraryVM.EditCommand}"
                                        Padding="10,4" Margin="0,0,8,4"
                                        Background="#9B59B6" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                                <Button Content="&#x1F5D1; 删除流程"
                                        Command="{Binding WorkflowVM.LibraryVM.DeleteCommand}"
                                        Padding="10,4" Margin="0,0,8,4"
                                        Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                            </WrapPanel>
                        </Border>

                        <!-- 列表 + 详情 -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 流程列表 -->
                            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Background="White">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,6">
                                        <TextBlock Text="&#x1F4DA; 已保存流程" FontSize="12" FontWeight="Bold" Foreground="#555"/>
                                    </Border>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding WorkflowVM.LibraryVM.Workflows}"
                                             SelectedItem="{Binding WorkflowVM.LibraryVM.SelectedWorkflow, Mode=TwoWay}"
                                             Background="White"
                                             BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:Workflow}">
                                                <StackPanel Margin="0,4">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#2C3E50"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding ActionCount}" FontSize="11" Foreground="#7F8C8D"/>
                                                        <TextBlock Text=" 步  |  " FontSize="11" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}" FontSize="11" Foreground="#7F8C8D"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" ShowsPreview="True" Cursor="SizeWE"/>

                            <!-- 流程详情 -->
                            <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,6">
                                        <TextBlock Text="&#x1F4C4; 流程详情" FontSize="12" FontWeight="Bold" Foreground="#555"/>
                                    </Border>

                                    <!-- 详情内容 -->
                                    <StackPanel Grid.Row="1" Margin="12" Visibility="{Binding WorkflowVM.LibraryVM.HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding WorkflowVM.LibraryVM.SelectedWorkflow.Name}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding WorkflowVM.LibraryVM.SelectedWorkflowDetail}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/>
                                        </Border>
                                        <TextBlock Text="动作预览:" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <Border BorderBrush="#E0E0E0" BorderThickness="1" Background="White" MaxHeight="180">
                                            <ListBox ItemsSource="{Binding WorkflowVM.LibraryVM.SelectedWorkflow.Actions}"
                                                     ItemTemplate="{StaticResource WorkflowActionItemTemplate}"
                                                     Background="White"
                                                     BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 空状态 -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding WorkflowVM.LibraryVM.HasSelection, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="&#x1F4C2;" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                                        <TextBlock Text="请从左侧选择一个流程" FontSize="13" Foreground="#888" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBlock Text="或点击「刷新列表」加载已保存流程" FontSize="11" Foreground="#AAA" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 播放参数 -->
                        <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="循环次数:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding WorkflowVM.LibraryVM.LoopCount, UpdateSourceTrigger=PropertyChanged}" Width="50" Padding="4" VerticalAlignment="Center" FontSize="12"/>

                                    <TextBlock Grid.Column="2" Text="循环间隔(ms):" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="12"/>
                                    <TextBox Grid.Column="3" Text="{Binding WorkflowVM.LibraryVM.LoopIntervalMs, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="4" VerticalAlignment="Center" FontSize="12"/>

                                    <TextBlock Grid.Column="4" Text="播放速度:" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="12"/>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Content="1x" GroupName="Speed" Margin="0,0,6,0"
                                                     IsChecked="{Binding WorkflowVM.LibraryVM.SpeedMultiplier, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=1}"
                                                     Cursor="Hand" FontSize="12"/>
                                        <RadioButton Content="2x" GroupName="Speed" Margin="0,0,6,0"
                                                     IsChecked="{Binding WorkflowVM.LibraryVM.SpeedMultiplier, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=2}"
                                                     Cursor="Hand" FontSize="12"/>
                                        <RadioButton Content="5x" GroupName="Speed"
                                                     IsChecked="{Binding WorkflowVM.LibraryVM.SpeedMultiplier, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=5}"
                                                     Cursor="Hand" FontSize="12"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="6" Text="{Binding WorkflowVM.LibraryVM.ProgressText}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" Foreground="#555"/>
                                </Grid>

                                <!-- v1.5.0: 智能监测开关 -->
                                <CheckBox Content="&#x1F9E0; 启用智能监测 (执行 WaitForWindow/ExtractText 动作)"
                                          IsChecked="{Binding WorkflowVM.LibraryVM.EnableSmartActions, Mode=TwoWay}"
                                          FontSize="12" Margin="0,8,0,0" VerticalContentAlignment="Center"
                                          ToolTip="启用后流程中的 WaitForWindow/ExtractText 智能动作才会执行；关闭时这些动作直接跳过，纯固定坐标回放 (兼容 v1.4.0)"/>
                            </StackPanel>
                        </Border>

                        <!-- 播放控制 -->
                        <Border Grid.Row="3" Background="#F0F4F8" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 进度信息 -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#x25B6;" FontSize="14" Foreground="#3498DB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#555">
                                        <Run Text="步骤: "/>
                                        <Run Text="{Binding WorkflowVM.LibraryVM.CurrentStep, Mode=OneWay}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding WorkflowVM.LibraryVM.TotalSteps, Mode=OneWay}"/>
                                        <Run Text="    |    循环: "/>
                                        <Run Text="{Binding WorkflowVM.LibraryVM.CurrentLoop, Mode=OneWay}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding WorkflowVM.LibraryVM.TotalLoops, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="1" Content="&#x25B6; 播放 (F6)"
                                        Command="{Binding WorkflowVM.LibraryVM.PlayCommand}"
                                        Padding="16,8" Margin="0,0,8,0"
                                        FontSize="13" FontWeight="Bold"
                                        Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                <Button Grid.Column="2" Content="&#x23F8; 暂停"
                                        Command="{Binding WorkflowVM.LibraryVM.PauseCommand}"
                                        Padding="16,8" Margin="0,0,8,0"
                                        FontSize="13" FontWeight="Bold"
                                        Background="#F39C12" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                <Button Grid.Column="3" Content="&#x23F9; 停止 (F6)"
                                        Command="{Binding WorkflowVM.LibraryVM.StopCommand}"
                                        Padding="16,8"
                                        FontSize="13" FontWeight="Bold"
                                        Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ========== Row 2: 单点连点底部参数 (仅单点连点模式可见) ========== -->
        <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12,10" Margin="0,8,0,0"
                Visibility="{Binding CurrentMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static local:ClickMode.SingleClick}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="鼠标按键:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                <RadioButton Grid.Column="1" Content="左键" GroupName="MouseBtn"
                             IsChecked="{Binding MouseButton, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:MouseButton.Left}}"
                             VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"/>
                <RadioButton Grid.Column="2" Content="右键" GroupName="MouseBtn"
                             IsChecked="{Binding MouseButton, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:MouseButton.Right}}"
                             VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand"/>
                <RadioButton Grid.Column="3" Content="中键" GroupName="MouseBtn"
                             IsChecked="{Binding MouseButton, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:MouseButton.Middle}}"
                             VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand"/>

                <TextBlock Grid.Column="5" Text="间隔 (ms):" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" HorizontalAlignment="Right"/>
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="SliderInterval" Minimum="1" Maximum="5000" Value="{Binding IntervalMs, Mode=TwoWay}"
                            Width="140" TickFrequency="100" IsSnapToTickEnabled="False"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtInterval" Text="{Binding IntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="60" Padding="4,2" VerticalAlignment="Center" VerticalContentAlignment="Center"
                             TextAlignment="Right" ToolTip="点击间隔毫秒数 (1-5000)"/>
                </StackPanel>

                <!-- 占位列 7 用于未来扩展 -->
            </Grid>
        </Border>

        <!-- ========== Row 3: 启停按钮 (单点连点模式专用) ========== -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Visibility="{Binding CurrentMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static local:ClickMode.SingleClick}}">
            <Button x:Name="BtnStart" Content="&#x25B6; 开始连点 (F6)"
                    Command="{Binding StartCommand}"
                    Padding="28,12" Margin="0,0,16,0"
                    FontSize="14" FontWeight="Bold"
                    Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand"
                    MinWidth="160"/>
            <Button x:Name="BtnStop" Content="&#x23F9; 停止连点 (F6)"
                    Command="{Binding StopCommand}"
                    Padding="28,12"
                    FontSize="14" FontWeight="Bold"
                    Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand"
                    MinWidth="160"/>
        </StackPanel>

        <!-- ========== Row 4: 状态栏 ========== -->
        <Border Grid.Row="4" Margin="0,12,0,0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#x25CF;" FontSize="12"
                           Foreground="{Binding IsClicking, Converter={StaticResource BoolToBrushConverter}}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding ClickCountText}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#555"/>
                <TextBlock Grid.Column="3" x:Name="TxtUptime" Text="{Binding UptimeText}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#888"/>
            </Grid>
        </Border>
    </Grid>
</Window>
