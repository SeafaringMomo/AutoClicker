<Window x:Class="AutoClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连点器 — AutoClicker"
        Width="520" Height="680"
        MinWidth="460" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Topmost="True">

    <Window.Resources>
        <!-- 样式 -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 标题 -->
            <RowDefinition Height="Auto"/> <!-- 模式选择 -->
            <RowDefinition Height="Auto"/> <!-- 鼠标按钮 -->
            <RowDefinition Height="Auto"/> <!-- 间隔设置 -->
            <RowDefinition Height="Auto"/> <!-- 模式1: 悬停 -->
            <RowDefinition Height="*"/>    <!-- 模式2: 窗口树 -->
            <RowDefinition Height="Auto"/> <!-- 控制按钮 -->
            <RowDefinition Height="Auto"/> <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ===== 标题 ===== -->
        <TextBlock Grid.Row="0" Text="🖱 连点器 AutoClicker"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#1A1A2E" Margin="0,0,0,8"/>

        <!-- ===== 连点模式 ===== -->
        <GroupBox Grid.Row="1" Header="连点模式" Margin="0,0,0,8" Padding="8">
            <StackPanel>
                <RadioButton x:Name="RbHoverMode"
                             Content="模式1: 悬停定位 — 鼠标移到目标位置后启动连点"
                             IsChecked="True"
                             GroupName="ClickMode"
                             Checked="OnModeChanged"
                             Margin="0,2"/>
                <RadioButton x:Name="RbWindowTreeMode"
                             Content="模式2: 窗口树定位 — 选择目标窗口控件进行连点"
                             GroupName="ClickMode"
                             Checked="OnModeChanged"
                             Margin="0,2"/>
                <TextBlock Text="💡 模式1适合游戏/简单界面；模式2适合抢票/后台点击"
                           FontSize="10" Foreground="Gray" Margin="16,4,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- ===== 鼠标按钮选择 ===== -->
        <GroupBox Grid.Row="2" Header="点击按钮" Margin="0,0,0,8" Padding="8">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbLeft" Content="左键" IsChecked="True"
                             GroupName="MouseButton" Checked="OnButtonChanged" Margin="0,0,16,0"/>
                <RadioButton x:Name="RbRight" Content="右键"
                             GroupName="MouseButton" Checked="OnButtonChanged" Margin="0,0,16,0"/>
                <RadioButton x:Name="RbMiddle" Content="中键"
                             GroupName="MouseButton" Checked="OnButtonChanged"/>
            </StackPanel>
        </GroupBox>

        <!-- ===== 间隔设置 ===== -->
        <GroupBox Grid.Row="3" Header="点击间隔" Margin="0,0,0,8" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="间隔:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="SliderInterval"
                        Grid.Column="1"
                        Minimum="1" Maximum="5000"
                        Value="100"
                        TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"
                        ValueChanged="OnIntervalChanged"/>
                <TextBox x:Name="TxtInterval"
                         Grid.Column="2"
                         Text="100"
                         Width="60" Margin="8,0"
                         VerticalAlignment="Center"
                         TextAlignment="Center"
                         TextChanged="OnIntervalTextChanged"/>
                <TextBlock Grid.Column="3" Text="ms" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- ===== 模式1: 悬停定位 ===== -->
        <GroupBox x:Name="GrpHoverMode" Grid.Row="4" Header="模式1: 悬停定位设置" Margin="0,0,0,8" Padding="8">
            <StackPanel>
                <TextBlock Text="1. 将鼠标移到目标位置" Style="{StaticResource StatusText}"/>
                <TextBlock Text="2. 按 F6 启动连点 (或点击下方按钮)" Style="{StaticResource StatusText}"/>
                <TextBlock Text="3. 再次按 F6 停止" Style="{StaticResource StatusText}" Margin="0,0,0,8"/>

                <Button x:Name="BtnCapturePosition"
                        Content="📍 捕获当前鼠标位置"
                        Click="OnCapturePosition"
                        Height="30" Margin="0,4"/>

                <TextBlock x:Name="TxtPositionInfo"
                           Text="当前目标位置: 未设置"
                           Style="{StaticResource StatusText}"
                           Foreground="#2980B9"/>
            </StackPanel>
        </GroupBox>

        <!-- ===== 模式2: 窗口树定位 ===== -->
        <GroupBox x:Name="GrpWindowTreeMode" Grid.Row="5"
                  Header="模式2: 窗口树定位" Margin="0,0,0,8" Padding="8"
                  Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="BtnRefreshWindows"
                            Content="🔄 刷新窗口列表"
                            Click="OnRefreshWindows"
                            Height="28" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPickWindow"
                            Content="🎯 十字准星选窗"
                            Click="OnPickWindow"
                            Height="28"/>
                </StackPanel>

                <TreeView x:Name="WindowTreeView"
                          Grid.Row="1"
                          SelectedItemChanged="OnWindowTreeSelected"
                          MinHeight="120" MaxHeight="250"
                          BorderBrush="#BDC3C7" BorderThickness="1"/>

                <StackPanel Grid.Row="2" Margin="0,8,0,4">
                    <TextBlock x:Name="TxtSelectedWindow"
                               Text="已选择: 无"
                               Style="{StaticResource StatusText}"
                               Foreground="#2980B9"/>
                    <CheckBox x:Name="ChkPostMessage"
                              Content="使用 PostMessage (异步, 抢票推荐)"
                              IsChecked="True" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 偏移坐标 (可选) -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="客户区偏移 X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtOffsetX" Text="0" Width="50" VerticalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text=" Y:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="TxtOffsetY" Text="0" Width="50" VerticalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="(0,0 为左上角)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" FontSize="10"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ===== 控制按钮 ===== -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
            <Button x:Name="BtnStart"
                    Content="▶ 启动连点"
                    Click="OnStartClick"
                    Width="120" Height="40"
                    FontSize="14" FontWeight="Bold"
                    Background="#27AE60" Foreground="White"
                    Margin="0,0,12,0"/>
            <Button x:Name="BtnStop"
                    Content="⏹ 停止连点"
                    Click="OnStopClick"
                    Width="120" Height="40"
                    FontSize="14" FontWeight="Bold"
                    Background="#E74C3C" Foreground="White"
                    IsEnabled="False"
                    Margin="0,0,12,0"/>
            <TextBlock VerticalAlignment="Center" Foreground="Gray" FontSize="11">
                <Run Text="热键: "/><Run Text="F6" FontWeight="Bold" Foreground="#E67E22"/>
            </TextBlock>
        </StackPanel>

        <!-- ===== 状态栏 ===== -->
        <Border Grid.Row="7" Background="#ECF0F1" CornerRadius="4" Padding="8" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus"
                           Grid.Column="0"
                           Text="状态: 就绪"
                           FontSize="12" FontWeight="Medium"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtClickCount"
                           Grid.Column="1"
                           Text="已点击: 0 次"
                           FontSize="12"
                           Foreground="#7F8C8D"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
